# Nextcloud on Drayve — environment variables
# Copy to .env and fill in your values.

# Domain for Nextcloud (must have DNS A-Record pointing to server)
NC_DOMAIN=cloud.example.com

# Nextcloud admin
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=<change-me>

# MariaDB
NC_DB_PASSWORD=<change-me>
NC_DB_ROOT_PASSWORD=<change-me>

# Redis
NC_REDIS_PASSWORD=<change-me>
