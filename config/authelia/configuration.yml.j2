---
# Authelia configuration — managed by Ansible.
# Template: config/authelia/configuration.yml.j2

theme: dark

server:
  address: tcp://0.0.0.0:9091

log:
  level: info

totp:
  issuer: "{{ drayve_domain }}"

authentication_backend:
{% if auth_lldap | default(false) | bool %}
  ldap:
    address: "ldap://lldap:{{ lldap_port | default(3890) }}"
    base_dn: "{{ lldap_base_dn | default('DC=drayve,DC=local') }}"
    users_filter: "(&({username_attribute}={input})(objectClass=person))"
    groups_filter: "(member={dn})"
    user: "uid=authelia,ou=people,{{ lldap_base_dn | default('DC=drayve,DC=local') }}"
    password: "{{ authelia_ldap_password }}"
{% else %}
  file:
    path: /config/users_database.yml
{% endif %}

access_control:
  default_policy: one_factor

session:
  secret: "{{ authelia_session_secret }}"
  cookies:
    - domain: "{{ drayve_domain }}"
      authelia_url: "https://auth.{{ drayve_domain }}"

storage:
  encryption_key: "{{ authelia_storage_encryption_key }}"
  local:
    path: /data/db.sqlite3

notifier:
  filesystem:
    filename: /data/notification.txt

identity_validation:
  reset_password:
    jwt_secret: "{{ authelia_jwt_secret }}"

identity_providers:
  oidc:
    hmac_secret: "{{ authelia_oidc_hmac_secret }}"
    jwks:
      - key_id: main
        algorithm: RS256
        key: |
          {{ authelia_jwks_pem | default('') | indent(10) }}
{% set _oidc_clients = authelia_oidc_clients | default(authelia_oidc_clients_default | default([])) %}
{% set _auth_policies = authelia_oidc_authorization_policies | default({}) %}
{% set _claims_policies = authelia_oidc_claims_policies | default({}) %}
{% if _auth_policies %}
    authorization_policies:
{%   for name, policy in _auth_policies.items() %}
      {{ name }}:
        default_policy: {{ policy.default_policy | default('deny') }}
{%     if policy.rules is defined %}
        rules:
{%       for rule in policy.rules %}
          - policy: {{ rule.policy }}
{%         if rule.subject is defined %}
            subject:
{%           for s in rule.subject %}
              - "{{ s }}"
{%           endfor %}
{%         endif %}
{%         if rule.networks is defined %}
            networks:
{%           for n in rule.networks %}
              - {{ n }}
{%           endfor %}
{%         endif %}
{%       endfor %}
{%     endif %}
{%   endfor %}
{% endif %}
{% if _claims_policies %}
    claims_policies:
{%   for name, policy in _claims_policies.items() %}
      {{ name }}:
{%     if policy.id_token is defined %}
        id_token:
{%       for c in policy.id_token %}
          - {{ c }}
{%       endfor %}
{%     endif %}
{%     if policy.access_token is defined %}
        access_token:
{%       for c in policy.access_token %}
          - {{ c }}
{%       endfor %}
{%     endif %}
{%   endfor %}
{% endif %}
    clients:
{% for c in _oidc_clients %}
      - client_id: {{ c.id }}
        client_name: {{ c.name | default(c.id) }}
        client_secret: '{{ (authelia_oidc_client_secret_hashes | default({}))[c.id] | default("") }}'
        authorization_policy: {{ c.authorization_policy | default('one_factor') }}
{%   if c.claims_policy is defined %}
        claims_policy: {{ c.claims_policy }}
{%   endif %}
{%   if c.consent_mode is defined %}
        consent_mode: {{ c.consent_mode }}
{%   endif %}
        redirect_uris:
{%   for uri in c.redirect_uris %}
          - "{{ uri }}"
{%   endfor %}
        scopes:
{%   for s in c.scopes | default(['openid', 'profile', 'email', 'groups']) %}
          - {{ s }}
{%   endfor %}
{%   if c.grant_types is defined %}
        grant_types:
{%     for g in c.grant_types %}
          - {{ g }}
{%     endfor %}
{%   endif %}
{%   if c.response_types is defined %}
        response_types:
{%     for r in c.response_types %}
          - {{ r }}
{%     endfor %}
{%   endif %}
{%   if c.token_endpoint_auth_method is defined %}
        token_endpoint_auth_method: {{ c.token_endpoint_auth_method }}
{%   endif %}
{% endfor %}
