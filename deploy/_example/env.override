# User app secrets — appended to .env on the server.
# Put secrets for your compose.override.yml services here.
# This file is NOT managed by Ansible — you own it.
#
# Example (Nextcloud):
# NC_DOMAIN=cloud.example.com
# NC_ADMIN_USER=admin
# NC_ADMIN_PASSWORD=change-me-now
# NC_DB_PASSWORD=change-me-now
# NC_DB_ROOT_PASSWORD=change-me-now
# NC_REDIS_PASSWORD=change-me-now
