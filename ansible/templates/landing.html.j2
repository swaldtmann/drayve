<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ drayve_domain }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #0f1117;
      color: #b0b8c8;
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      font-weight: 300;
      min-height: 100vh;
    }
    .container { max-width: 64rem; margin: 0 auto; padding: 3rem 1.5rem; }
    header { margin-bottom: 3rem; }
    header h1 {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 1.875rem;
      font-weight: 300;
      color: #e8ecf2;
      letter-spacing: 0.06em;
    }
    header p { color: #6b7280; margin-top: 0.5rem; font-size: 0.875rem; }
    section { margin-bottom: 2.5rem; }
    section h2 {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 1.25rem;
      font-weight: 400;
      color: #e8ecf2;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid #1e2130;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1rem;
    }
    .card {
      background: #161926;
      border: 1px solid #1e2130;
      border-radius: 0.5rem;
      padding: 1.25rem;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.2s, background 0.2s;
    }
    a.card:hover { border-color: #3b82f6; background: #1a1e2e; }
    .card-header { display: flex; align-items: center; justify-content: space-between; }
    .card-title { display: flex; align-items: center; gap: 0.75rem; }
    .card-title .icon { font-size: 1.5rem; }
    .card-title h3 { font-size: 1rem; font-weight: 400; color: #e8ecf2; }
    .badge {
      font-size: 0.7rem;
      padding: 0.15rem 0.5rem;
      border-radius: 0.25rem;
      background: rgba(59, 130, 246, 0.15);
      color: #3b82f6;
      border: 1px solid rgba(59, 130, 246, 0.3);
    }
    .card p { color: #6b7280; font-size: 0.8rem; margin-top: 0.5rem; }
    footer { text-align: center; color: #3a3f50; font-size: 0.75rem; margin-top: 3rem; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>{{ drayve_domain }}</h1>
      <p>{{ ansible_host | default('') }} &mdash; Managed by Drayve</p>
    </header>

{% if auth_provider == 'authelia' %}
    <section>
      <h2>Auth</h2>
      <div class="grid">
        <a href="https://auth.{{ drayve_domain }}" target="_blank" class="card">
          <div class="card-header">
            <div class="card-title"><span class="icon">&#x1F510;</span><h3>Authelia</h3></div>
            <span class="badge">auth</span>
          </div>
          <p>Login &amp; Single Sign-On</p>
        </a>
{% if auth_lldap | default(false) | bool %}
        <a href="https://ldap.{{ drayve_domain }}" target="_blank" class="card">
          <div class="card-header">
            <div class="card-title"><span class="icon">&#x1F465;</span><h3>LLDAP</h3></div>
            <span class="badge">ldap</span>
          </div>
          <p>User directory &amp; groups</p>
        </a>
{% endif %}
      </div>
    </section>
{% endif %}

{% if monitoring_services.grafana | default(false) | bool %}
    <section>
      <h2>Monitoring</h2>
      <div class="grid">
        <a href="https://grafana.{{ drayve_domain }}" target="_blank" class="card">
          <div class="card-header">
            <div class="card-title"><span class="icon">&#x1F4CA;</span><h3>Grafana</h3></div>
            <span class="badge">grafana</span>
          </div>
          <p>Dashboards, metrics, logs</p>
        </a>
        <a href="https://grafana.{{ drayve_domain }}/d/drayve-overview" target="_blank" class="card">
          <div class="card-header">
            <div class="card-title"><span class="icon">&#x1F4CB;</span><h3>Stack Overview</h3></div>
            <span class="badge">dashboard</span>
          </div>
          <p>Services, uptime, alerts</p>
        </a>
        <a href="https://grafana.{{ drayve_domain }}/d/drayve-host" target="_blank" class="card">
          <div class="card-header">
            <div class="card-title"><span class="icon">&#x1F5A5;</span><h3>Host</h3></div>
            <span class="badge">dashboard</span>
          </div>
          <p>CPU, memory, disk, network</p>
        </a>
        <a href="https://grafana.{{ drayve_domain }}/d/drayve-containers" target="_blank" class="card">
          <div class="card-header">
            <div class="card-title"><span class="icon">&#x1F4E6;</span><h3>Containers</h3></div>
            <span class="badge">dashboard</span>
          </div>
          <p>Container metrics, restarts</p>
        </a>
        <a href="https://grafana.{{ drayve_domain }}/d/drayve-traefik" target="_blank" class="card">
          <div class="card-header">
            <div class="card-title"><span class="icon">&#x1F6E3;</span><h3>Traefik</h3></div>
            <span class="badge">dashboard</span>
          </div>
          <p>Requests, latency, status codes</p>
        </a>
{% if monitoring_services.loki | default(false) | bool %}
        <a href="https://grafana.{{ drayve_domain }}/d/loki-logs" target="_blank" class="card">
          <div class="card-header">
            <div class="card-title"><span class="icon">&#x1F4DC;</span><h3>Logs</h3></div>
            <span class="badge">dashboard</span>
          </div>
          <p>Container logs via Loki</p>
        </a>
{% endif %}
{% if crowdsec_enabled | default(true) %}
        <a href="https://grafana.{{ drayve_domain }}/d/crowdsec-overview" target="_blank" class="card">
          <div class="card-header">
            <div class="card-title"><span class="icon">&#x1F6E1;</span><h3>CrowdSec</h3></div>
            <span class="badge">dashboard</span>
          </div>
          <p>Bans, alerts, bouncer status</p>
        </a>
{% endif %}
      </div>
    </section>
{% endif %}

    <section>
      <h2>Infrastructure</h2>
      <div class="grid">
        <a href="https://traefik.{{ drayve_domain }}" target="_blank" class="card">
          <div class="card-header">
            <div class="card-title"><span class="icon">&#x1F6E3;</span><h3>Traefik</h3></div>
            <span class="badge">reverse proxy</span>
          </div>
          <p>TLS, routing, middleware</p>
        </a>
{% if crowdsec_enabled | default(true) %}
        <div class="card">
          <div class="card-header">
            <div class="card-title"><span class="icon">&#x1F6E1;</span><h3>CrowdSec</h3></div>
            <span class="badge">active</span>
          </div>
          <p>Intrusion prevention</p>
        </div>
{% endif %}
        <div class="card">
          <div class="card-header">
            <div class="card-title"><span class="icon">&#x1F525;</span><h3>UFW Firewall</h3></div>
            <span class="badge">22, 80, 443</span>
          </div>
          <p>Default deny, SSH + HTTP(S) only</p>
        </div>
      </div>
    </section>

    <footer>drayve {{ drayve_version | default('0.1.0') }}</footer>
  </div>
</body>
</html>
