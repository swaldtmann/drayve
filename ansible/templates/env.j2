# --- Hetzner DNS (for ACME DNS challenge) ---
HETZNER_API_TOKEN={{ hetzner_api_token | default('') }}

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password | default('changeme') }}

# --- CrowdSec ---
CROWDSEC_BOUNCER_KEY={{ crowdsec_bouncer_key | default('') }}
CROWDSEC_LAPI_KEY={{ crowdsec_lapi_key | default('') }}

# --- LLDAP ---
LLDAP_JWT_SECRET={{ lldap_jwt_secret | default('') }}
LLDAP_ADMIN_PASSWORD={{ lldap_admin_password | default('') }}

# --- Authelia ---
AUTHELIA_JWT_SECRET={{ authelia_jwt_secret | default('') }}
AUTHELIA_SESSION_SECRET={{ authelia_session_secret | default('') }}
AUTHELIA_STORAGE_ENCRYPTION_KEY={{ authelia_storage_encryption_key | default('') }}
