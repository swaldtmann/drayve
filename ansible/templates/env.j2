# --- Authentik ---
AUTHENTIK_SECRET_KEY={{ authentik_secret_key | default('') }}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_bootstrap_password | default('') }}
AUTHENTIK_PG_PASS={{ authentik_pg_pass | default('') }}
PG_PASS={{ authentik_pg_pass | default('') }}
