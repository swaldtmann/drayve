server:
  http_listen_port: 9080
  grpc_listen_port: 0
positions:
  filename: /tmp/positions.yaml
clients:
  - url: "{{ _promtail_loki_url }}"
{% if _promtail_loki_basic_auth_user %}
    basic_auth:
      username: "{{ _promtail_loki_basic_auth_user }}"
      password_file: /etc/promtail/loki-basic-auth-password
{% endif %}
{% if _promtail_host_label %}
    external_labels:
      host: "{{ _promtail_host_label }}"
{% endif %}
scrape_configs:
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: 'container'
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: 'service'
{% for cfg in monitoring_promtail_extra_scrape_configs %}
  - {{ cfg | to_nice_yaml(indent=2) | indent(4) | trim }}
{% endfor %}
