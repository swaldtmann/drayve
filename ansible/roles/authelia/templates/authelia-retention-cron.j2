{{ authelia_auth_log_retention_schedule }} root AUTHELIA_DB={{ authelia_data_dir }}/db.sqlite3 RETENTION_DAYS={{ authelia_auth_log_retention_days }} /usr/local/sbin/drayve-authelia-retention >> {{ authelia_auth_log_retention_log_file }} 2>&1
