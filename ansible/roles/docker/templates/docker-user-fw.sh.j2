#!/bin/bash
# {{ ansible_managed }}
# DOCKER-USER firewall baseline (default DROP), installed by drayve role 'docker'.
# Idempotent: flushes and rebuilds the DOCKER-USER chain on every run.
# Docker evaluates DOCKER-USER before its own forwarding rules and never flushes it.
set -euo pipefail

iptables -N DOCKER-USER 2>/dev/null || true
iptables -F DOCKER-USER

# Replies to connections that are already allowed.
iptables -A DOCKER-USER -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
# Traffic coming from containers (outbound, container-to-container).
iptables -A DOCKER-USER -i docker0 -j RETURN
iptables -A DOCKER-USER -i br+ -j RETURN
# Published ports that may be reached from outside (original destination port,
# i.e. before Docker's DNAT).
{% for item in docker_firewall_allowed_ports %}
iptables -A DOCKER-USER -p {{ item.proto | default('tcp') }} -m conntrack --ctorigdstport {{ item.port }} --ctdir ORIGINAL -j RETURN
{% endfor %}
# Everything else from outside.
iptables -A DOCKER-USER -j DROP
