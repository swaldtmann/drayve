# {{ ansible_managed }}
# kedge environment — sourced by /etc/cron.d/drayve-kedge*
# Do not edit by hand; regenerated by drayve role 'backup' (target=kedge).

STACK_DIR={{ backup_kedge_stack_dir }}
RESTIC_REPOSITORY={{ backup_kedge_restic_repository }}
RESTIC_PASSWORD={{ backup_restic_password }}
BACKUP_STOP_STACK={{ 'true' if backup_kedge_stop_stack | bool else 'false' }}
{% if backup_kedge_exclude_mounts | length > 0 %}
BACKUP_EXCLUDE_MOUNTS="{{ backup_kedge_exclude_mounts }}"
{% endif %}
BACKUP_KEEP_DAILY={{ backup_retain_daily }}
BACKUP_KEEP_WEEKLY={{ backup_retain_weekly }}
BACKUP_KEEP_MONTHLY={{ backup_retain_monthly }}
{% if backup_kedge_healthcheck_url | length > 0 %}
BACKUP_HEALTHCHECK_URL={{ backup_kedge_healthcheck_url }}
{% endif %}
