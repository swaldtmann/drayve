[Unit]
Description=Drayve Bouncer-Watchdog Timer
Documentation=https://github.com/StephanWaldtmann/drayve

[Timer]
# One tick every bouncer_watchdog_interval_seconds.
OnBootSec=60s
OnUnitActiveSec={{ bouncer_watchdog_interval_seconds }}s
AccuracySec=1s
Unit=drayve-bouncer-watchdog.service

[Install]
WantedBy=timers.target
