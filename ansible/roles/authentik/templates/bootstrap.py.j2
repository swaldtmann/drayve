#!/usr/bin/env python3
"""Authentik Zero-Touch Bootstrap.

Runs after compose up — configures Authentik via API.
Creates API token via Django shell, then configures providers + applications.
"""

import json
import os
import subprocess
import sys
import time
import urllib.parse
import urllib.request
import urllib.error

DOMAIN = "{{ drayve_domain }}"
LANDING_DOMAIN = "{{ authentik_landing_domain }}"
ADMIN_GROUP = {{ authentik_admin_group | tojson }}
GRAFANA_SECRET = "{{ authentik_oidc_grafana_secret }}"

# LDAP Source config (from stack.yaml auth.ldap)
LDAP_ENABLED = {{ authentik_ldap_enabled | bool | ternary('True', 'False') }}
LDAP_HOST = "{{ authentik_ldap_host }}"
LDAP_PORT = {{ authentik_ldap_port }}
LDAP_BASE_DN = "{{ authentik_ldap_base_dn }}"
LDAP_BIND_DN = "{{ authentik_ldap_bind_dn }}"
LDAP_SYNC_INTERVAL = {{ authentik_ldap_sync_interval }}
LDAP_START_TLS = {{ authentik_ldap_start_tls | bool | ternary('True', 'False') }}
LDAP_USER_DN = {{ authentik_ldap_user_dn | tojson }}
LDAP_GROUP_DN = {{ authentik_ldap_group_dn | tojson }}
LDAP_USER_FILTER = {{ authentik_ldap_user_filter | tojson }}
LDAP_GROUP_FILTER = {{ authentik_ldap_group_filter | tojson }}
LDAP_UNIQUENESS_FIELD = {{ authentik_ldap_uniqueness_field | tojson }}
LDAP_GROUP_MEMBERSHIP_FIELD = {{ authentik_ldap_group_membership_field | tojson }}
# Built-in user mappings, by suffix of goauthentik.io/sources/ldap/<suffix>
LDAP_USER_MAPPINGS = {{ authentik_ldap_user_mappings | tojson }}
LDAP_GROUP_NAME_ATTR = {{ authentik_ldap_group_name_attr | tojson }}
LDAP_TLS_CA_NAME = {{ authentik_ldap_tls_ca_name | tojson }}
LDAP_MANAGED_PREFIX = "goauthentik.io/sources/ldap/"
LDAP_GROUP_MAPPING_NAME = "drayve LDAP Mapping: group name"

MAX_RETRIES = 3
RETRY_DELAY = 2

FLOW_AUTH_IMPLICIT = "default-provider-authorization-implicit-consent"
FLOW_AUTH_EXPLICIT = "default-provider-authorization-explicit"
FLOW_INVALIDATION = "default-provider-invalidation-flow"
# Seconds to wait for the implicit-consent flow before falling back to explicit.
IMPLICIT_GRACE = 60


def log(msg):
    print(f"[bootstrap] {msg}", file=sys.stderr)


def get_container_ip(name):
    """Get container IP from Docker network."""
    result = subprocess.run(
        ["docker", "inspect", name,
         "--format", "{% raw %}{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}{% endraw %}"],
        capture_output=True, text=True, check=True,
    )
    return result.stdout.strip()


def wait_for_ready(base_url, timeout=300, interval=5):
    """Wait for Authentik health endpoint."""
    url = f"{base_url}/-/health/ready/"
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            req = urllib.request.Request(url)
            urllib.request.urlopen(req, timeout=5)
            return
        except (urllib.error.URLError, OSError):
            time.sleep(interval)
    raise RuntimeError(f"Authentik not ready after {timeout}s")


def ensure_api_token():
    """Create or retrieve API token via Django shell."""
    script = """
import os, django
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'authentik.root.settings')
django.setup()
from authentik.core.models import Token, TokenIntents, User
user = User.objects.get(username='akadmin')
token, created = Token.objects.get_or_create(
    identifier='drayve-bootstrap',
    defaults={'user': user, 'intent': TokenIntents.INTENT_API, 'expiring': False}
)
print(token.key)
"""
    for attempt in range(1, MAX_RETRIES + 1):
        result = subprocess.run(
            ["docker", "exec", "authentik-server", "python", "-c", script],
            capture_output=True, text=True,
        )
        if result.returncode == 0:
            token = result.stdout.strip().split("\n")[-1]
            if len(token) >= 10:
                return token
            log(f"Token too short: {token!r}")
        else:
            log(f"Django shell failed (attempt {attempt}/{MAX_RETRIES}): {result.stderr.strip()}")
        if attempt < MAX_RETRIES:
            time.sleep(RETRY_DELAY * attempt)

    raise RuntimeError("Failed to create/retrieve API token after retries")


class AuthentikAPI:
    """Simple Authentik API client with retry logic."""

    def __init__(self, base_url, token):
        self.base_url = base_url
        self.token = token

    def _request(self, method, path, data=None):
        url = f"{self.base_url}{path}"
        body = json.dumps(data).encode() if data else None
        headers = {
            "Authorization": f"Bearer {self.token}",
            "Content-Type": "application/json",
        }
        for attempt in range(1, MAX_RETRIES + 1):
            try:
                req = urllib.request.Request(url, data=body, headers=headers, method=method)
                with urllib.request.urlopen(req, timeout=30) as resp:
                    return json.loads(resp.read())
            except urllib.error.HTTPError as e:
                # 4xx = client error, don't retry — let caller handle
                if 400 <= e.code < 500:
                    raise
                error_body = e.read().decode() if e.fp else ""
                if attempt == MAX_RETRIES:
                    log(f"FAILED {method} {path} (attempt {attempt}): {e.code} {error_body}")
                    raise
                log(f"Retry {attempt}/{MAX_RETRIES} for {method} {path}: {e.code}")
                time.sleep(RETRY_DELAY * attempt)
            except (urllib.error.URLError, OSError) as e:
                if attempt == MAX_RETRIES:
                    log(f"FAILED {method} {path} (attempt {attempt}): {e}")
                    raise
                log(f"Retry {attempt}/{MAX_RETRIES} for {method} {path}: {e}")
                time.sleep(RETRY_DELAY * attempt)

    def get(self, path):
        return self._request("GET", path)

    def post(self, path, data):
        return self._request("POST", path, data)

    def patch(self, path, data):
        return self._request("PATCH", path, data)


def get_flow(api, slug):
    """Get flow PK by slug."""
    resp = api.get(f"/flows/instances/?slug={slug}&page_size=50")
    results = resp.get("results", [])
    return results[0]["pk"] if results else None


def wait_for_flows(api, timeout=300, interval=5):
    """Wait until the default flows exist; return (authorization_pk, invalidation_pk).

    authentik creates them asynchronously via blueprints after /-/health/ready/.
    Implicit consent is preferred; explicit consent is used only if implicit is
    still missing after IMPLICIT_GRACE seconds.
    """
    start = time.time()
    deadline = start + timeout
    while True:
        auth_flow = get_flow(api, FLOW_AUTH_IMPLICIT)
        if not auth_flow and time.time() - start >= IMPLICIT_GRACE:
            auth_flow = get_flow(api, FLOW_AUTH_EXPLICIT)
            if auth_flow:
                log("WARNING: Implicit consent flow not found — using explicit consent")
        inval_flow = get_flow(api, FLOW_INVALIDATION)
        if auth_flow and inval_flow:
            return auth_flow, inval_flow
        if time.time() >= deadline:
            break
        time.sleep(interval)
    missing = []
    if not auth_flow:
        missing.append(f"{FLOW_AUTH_IMPLICIT} / {FLOW_AUTH_EXPLICIT}")
    if not inval_flow:
        missing.append(FLOW_INVALIDATION)
    raise RuntimeError(f"Authentik flows missing after {timeout}s: {', '.join(missing)}")


def get_embedded_outpost(api):
    """Find the embedded outpost PK."""
    resp = api.get("/outposts/instances/?page_size=50")
    for o in resp.get("results", []):
        if "Embedded" in o.get("name", ""):
            return o["pk"]
    return None


def ensure_outpost_host(api, outpost_pk):
    """Set authentik_host of the embedded outpost to https://auth.<domain> (idempotent).

    Unset, forwardAuth redirects point at http://localhost/application/o/authorize/.
    """
    host = f"https://auth.{DOMAIN}"
    config = dict(api.get(f"/outposts/instances/{outpost_pk}/").get("config") or {})
    if config.get("authentik_host") == host:
        return
    config["authentik_host"] = host
    api.patch(f"/outposts/instances/{outpost_pk}/", {"config": config})
    log(f"Embedded outpost authentik_host set to {host}")


def ensure_proxy_provider(api, name, external_host, auth_flow, inval_flow):
    """Create proxy provider if it doesn't exist. Returns PK."""
    resp = api.get(f"/providers/proxy/?name={name}&page_size=50")
    results = resp.get("results", [])
    exact = [r for r in results if r.get("name") == name]
    if exact:
        pk = exact[0]["pk"]
        if exact[0].get("external_host") != external_host:
            # mode is required: a partial update is validated as proxy mode otherwise (HTTP 400)
            api.patch(f"/providers/proxy/{pk}/", {
                "external_host": external_host,
                "mode": exact[0].get("mode", "forward_single"),
            })
            log(f"Provider '{name}' (pk={pk}): external_host corrected")
        else:
            log(f"Provider '{name}' already exists (pk={pk})")
        return pk

    try:
        resp = api.post("/providers/proxy/", {
            "name": name,
            "authorization_flow": auth_flow,
            "invalidation_flow": inval_flow,
            "external_host": external_host,
            "mode": "forward_single",
            "access_token_validity": "hours=24",
        })
        pk = resp["pk"]
        log(f"Created proxy provider '{name}' (pk={pk})")
        return pk
    except urllib.error.HTTPError as e:
        body = e.read().decode() if e.fp else ""
        if e.code == 400 and "already exists" in body:
            log(f"Provider '{name}' already exists (confirmed by 400)")
            # Re-fetch to get the pk
            resp = api.get(f"/providers/proxy/?name={name}&page_size=50")
            for r in resp.get("results", []):
                if r.get("name") == name:
                    return r["pk"]
        raise


def ensure_oauth2_provider(api, name, client_id, client_secret, redirect_url,
                           auth_flow, inval_flow):
    """Create OAuth2 provider if it doesn't exist. Returns PK."""
    resp = api.get(f"/providers/oauth2/?name={name}&page_size=50")
    results = resp.get("results", [])
    exact = [r for r in results if r.get("name") == name]
    if exact:
        pk = exact[0]["pk"]
        log(f"OAuth2 provider '{name}' already exists (pk={pk})")
        return pk

    try:
        resp = api.post("/providers/oauth2/", {
            "name": name,
            "authorization_flow": auth_flow,
            "invalidation_flow": inval_flow,
            "client_type": "confidential",
            "client_id": client_id,
            "client_secret": client_secret,
            "redirect_uris": [{"matching_mode": "strict", "url": redirect_url}],
            "grant_types": ["authorization_code", "refresh_token"],
            "property_mappings": [],
            "signing_key": None,
        })
        pk = resp["pk"]
        log(f"Created OAuth2 provider '{name}' (pk={pk})")
        return pk
    except urllib.error.HTTPError as e:
        body = e.read().decode() if e.fp else ""
        if e.code == 400 and "already exists" in body:
            log(f"OAuth2 provider '{name}' already exists (confirmed by 400)")
            resp = api.get(f"/providers/oauth2/?name={name}&page_size=50")
            for r in resp.get("results", []):
                if r.get("name") == name:
                    return r["pk"]
        raise


def ensure_application(api, name, slug, provider_pk):
    """Create application if it doesn't exist.

    Note: Authentik's slug search may return empty results even when the app
    exists (possible eventual consistency after create). We fall back to
    treating 400 "already exists" on POST as success (idempotent).
    """
    resp = api.get(f"/core/applications/?slug={slug}&page_size=50")
    results = resp.get("results", [])
    exact = [r for r in results if r.get("slug") == slug]
    if exact:
        log(f"Application '{slug}' already exists")
        return exact[0]["pk"]

    try:
        resp = api.post("/core/applications/", {
            "name": name,
            "slug": slug,
            "provider": provider_pk,
        })
        log(f"Created application: {name} (slug={slug})")
        return resp["pk"]
    except urllib.error.HTTPError as e:
        body = e.read().decode() if e.fp else ""
        if e.code == 400 and "already exists" in body:
            log(f"Application '{slug}' already exists (confirmed by 400)")
            resp = api.get(f"/core/applications/?slug={slug}&page_size=50")
            for r in resp.get("results", []):
                if r.get("slug") == slug:
                    return r["pk"]
        raise


def ensure_admin_group(api, name, timeout=300, interval=5):
    """Return the PK of the admin group (name = cn of the synced LDAP group).

    With an LDAP source the group arrives with the (asynchronous) sync, so poll for it and fail
    clearly if it never shows up. Without LDAP there is nothing to sync: create it locally.
    """
    deadline = time.time() + timeout
    while True:
        resp = api.get(f"/core/groups/?name={urllib.parse.quote(name)}&page_size=50")
        for r in resp.get("results", []):
            if r.get("name") == name:
                return r["pk"]
        if not (LDAP_ENABLED and LDAP_HOST):
            pk = api.post("/core/groups/", {"name": name})["pk"]
            log(f"Created local group '{name}' (no LDAP source)")
            return pk
        if time.time() >= deadline:
            raise RuntimeError(
                f"Admin group '{name}' not found in Authentik after {timeout}s — "
                "is it in the LDAP source (group filter / ou) and synced?"
            )
        time.sleep(interval)


def ensure_group_binding(api, application_pk, group_pk):
    """Bind the application to a group policy (idempotent). With any binding, only members get in."""
    resp = api.get(f"/policies/bindings/?target={application_pk}&group={group_pk}&page_size=50")
    for r in resp.get("results", []):
        if r.get("target") == application_pk and r.get("group") == group_pk:
            return
    api.post("/policies/bindings/", {
        "target": application_pk,
        "group": group_pk,
        "order": 0,
        "enabled": True,
        "negate": False,
        "timeout": 30,
    })
    log(f"Bound application {application_pk} to group {group_pk}")


def assign_to_outpost(api, outpost_pk, provider_pk):
    """Add provider to embedded outpost if not already assigned."""
    if not outpost_pk:
        return

    resp = api.get(f"/outposts/instances/{outpost_pk}/?page_size=50")
    current = resp.get("providers", [])
    if provider_pk in current:
        return

    current.append(provider_pk)
    api.patch(f"/outposts/instances/{outpost_pk}/", {"providers": current})
    log(f"Assigned provider pk={provider_pk} to embedded outpost")


def get_ldap_property_mappings(api):
    """Return the PKs of the configured built-in LDAP user mappings that exist.

    Selection is exact (managed == goauthentik.io/sources/ldap/<suffix> for each
    suffix in LDAP_USER_MAPPINGS) — never "everything with ldap in its name":
    ms-samaccountname yields username None on a 389-DS.
    """
    # Try v3 API endpoint first, fall back to legacy
    for endpoint in ["/propertymappings/source/ldap/?page_size=200",
                     "/propertymappings/ldap/?page_size=200"]:
        try:
            resp = api.get(endpoint)
            break
        except urllib.error.HTTPError:
            resp = {"results": []}

    by_managed = {m.get("managed"): m["pk"] for m in resp.get("results", []) if m.get("managed")}
    return [by_managed[LDAP_MANAGED_PREFIX + s] for s in LDAP_USER_MAPPINGS
            if LDAP_MANAGED_PREFIX + s in by_managed]


def wait_for_ldap_property_mappings(api, timeout=300, interval=5):
    """Wait until all configured built-in LDAP user mappings exist; return their PKs.

    authentik creates them asynchronously via blueprints after /-/health/ready/;
    POST /sources/ldap/ with sync_users and an empty list fails with HTTP 400.
    """
    deadline = time.time() + timeout
    while True:
        user_mappings = get_ldap_property_mappings(api)
        if len(user_mappings) == len(LDAP_USER_MAPPINGS):
            return user_mappings
        if time.time() >= deadline:
            break
        time.sleep(interval)
    raise RuntimeError(
        f"Authentik LDAP property mappings missing after {timeout}s: user "
        f"(found {len(user_mappings)} of {len(LDAP_USER_MAPPINGS)} configured)"
    )


def ensure_group_name_mapping(api):
    """Create (or find) the group mapping that sets the group name; return its PK.

    authentik 2026.8 ships no group mapping, and sync_groups needs one that sets ``name``.
    """
    name = LDAP_GROUP_MAPPING_NAME
    resp = api.get(f"/propertymappings/source/ldap/?name={urllib.parse.quote(name)}&page_size=50")
    for r in resp.get("results", []):
        if r.get("name") == name:
            return r["pk"]
    resp = api.post("/propertymappings/source/ldap/", {
        "name": name,
        "expression": 'return {"name": ldap.get(' + json.dumps(LDAP_GROUP_NAME_ATTR) + ')}',
    })
    log(f"Created LDAP group mapping '{name}' (pk={resp['pk']})")
    return resp["pk"]


def get_peer_certificate(api):
    """PK of the CA keypair used to verify the LDAP server, or None (no verification)."""
    if not LDAP_TLS_CA_NAME:
        return None
    resp = api.get(f"/crypto/certificatekeypairs/?name={urllib.parse.quote(LDAP_TLS_CA_NAME)}&page_size=50")
    for r in resp.get("results", []):
        if r.get("name") == LDAP_TLS_CA_NAME:
            return r["pk"]
    raise RuntimeError(f"LDAP TLS CA keypair '{LDAP_TLS_CA_NAME}' not found in Authentik")


def ensure_ldap_source(api, bind_password):
    """Create or update LDAP source for DS389. Returns source slug."""
    slug = "drayve-ldap"
    name = "LDAP (DS389)"

    # Check if source exists
    resp = api.get(f"/sources/ldap/?slug={slug}&page_size=50")
    results = resp.get("results", [])
    existing = [r for r in results if r.get("slug") == slug]

    # Build server_uri
    protocol = "ldaps" if LDAP_PORT == 636 else "ldap"
    server_uri = f"{protocol}://{LDAP_HOST}:{LDAP_PORT}"

    # Get property mappings
    user_mappings = wait_for_ldap_property_mappings(api)
    group_mappings = [ensure_group_name_mapping(api)]
    peer_certificate = get_peer_certificate(api)

    source_data = {
        "name": name,
        "slug": slug,
        "enabled": True,
        "server_uri": server_uri,
        "bind_cn": LDAP_BIND_DN,
        "bind_password": bind_password,
        "base_dn": LDAP_BASE_DN,
        "sync_users": True,
        "sync_users_password": False,  # No writeback to read-only DS389
        "password_login_update_internal_password": True,  # Import on first login
        "sync_groups": True,
        "user_property_mappings": user_mappings,
        "group_property_mappings": group_mappings,
        "start_tls": LDAP_START_TLS,
        "additional_user_dn": LDAP_USER_DN,
        "additional_group_dn": LDAP_GROUP_DN,
        "user_object_filter": LDAP_USER_FILTER,
        "group_object_filter": LDAP_GROUP_FILTER,
        "object_uniqueness_field": LDAP_UNIQUENESS_FIELD,
        "group_membership_field": LDAP_GROUP_MEMBERSHIP_FIELD,
        "peer_certificate": peer_certificate,  # None = server certificate not verified
    }

    if existing:
        api.patch(f"/sources/ldap/{slug}/", source_data)
        log(f"Updated LDAP source '{name}' (slug={slug})")
    else:
        try:
            resp = api.post("/sources/ldap/", source_data)
            pk = resp["pk"]
            log(f"Created LDAP source '{name}' (pk={pk})")
        except urllib.error.HTTPError as e:
            body = e.read().decode() if e.fp else ""
            if e.code == 400 and "already exists" in body:
                log(f"LDAP source '{slug}' already exists (confirmed by 400)")
                return slug
            log(f"LDAP source creation failed ({e.code}): {body}")
            raise

    return slug


def main():
    if not ADMIN_GROUP:
        raise RuntimeError(
            "auth.admin_group is required with auth.provider=authentik: the LDAP group whose members "
            "may use Landing, Traefik dashboard, whoami and Grafana (no default allow)"
        )
    # 1. Resolve container IP and wait for ready
    ip = get_container_ip("authentik-server")
    base_url = f"http://{ip}:9000/api/v3"
    log(f"Authentik IP: {ip}")

    wait_for_ready(f"http://{ip}:9000")
    log("Authentik is ready.")

    # 2. Ensure API token
    token = ensure_api_token()
    log("API token ready.")
    api = AuthentikAPI(base_url, token)

    # 3. Get flows (blueprints apply them asynchronously — wait, never continue with None)
    auth_flow, inval_flow = wait_for_flows(api)
    log(f"Authorization flow: {auth_flow}")
    log(f"Invalidation flow: {inval_flow}")

    # 4. Get embedded outpost
    outpost = get_embedded_outpost(api)
    if not outpost:
        log("WARNING: Embedded outpost not found")
    else:
        ensure_outpost_host(api, outpost)

    # 5. Create proxy providers + applications
    app_pks = []
    for name, host, slug in [
        ("whoami", f"https://whoami.{DOMAIN}", "whoami"),
        ("landing", f"https://{LANDING_DOMAIN}", "landing"),
        ("traefik-dashboard", f"https://traefik.{DOMAIN}", "traefik-dashboard"),
    ]:
        pk = ensure_proxy_provider(api, name, host, auth_flow, inval_flow)
        app_pks.append(ensure_application(api, name.replace("-", " ").title(), slug, pk))
        assign_to_outpost(api, outpost, pk)

    # 6. Grafana OIDC
    gf_pk = ensure_oauth2_provider(
        api, "grafana", "grafana", GRAFANA_SECRET,
        f"https://grafana.{DOMAIN}/login/generic_oauth",
        auth_flow, inval_flow,
    )
    app_pks.append(ensure_application(api, "Grafana", "grafana", gf_pk))

    # 7. LDAP Source (if configured)
    if LDAP_ENABLED and LDAP_HOST:
        ldap_bind_pw = os.environ.get("AUTHENTIK_LDAP_BIND_PASSWORD", "")
        if not ldap_bind_pw:
            log("WARNING: LDAP enabled but AUTHENTIK_LDAP_BIND_PASSWORD not set — skipping")
        else:
            ldap_slug = ensure_ldap_source(api, ldap_bind_pw)
            # No trigger endpoint in authentik 2026.8: saving the source starts the sync itself.
            log(f"LDAP source '{ldap_slug}' saved — authentik starts the sync itself")
    elif LDAP_ENABLED:
        log("WARNING: LDAP enabled but no host configured — skipping")

    # 8. Only the admin group may use the applications (the group arrives with the LDAP sync above)
    group_pk = ensure_admin_group(api, ADMIN_GROUP)
    for app_pk in app_pks:
        ensure_group_binding(api, app_pk, group_pk)

    log("Bootstrap complete.")


if __name__ == "__main__":
    main()
