#!/usr/bin/env bash
# commit-msg hook: require a ticket reference in the commit message.
#
# This is the maintainer's convention, not a requirement for contributors:
# it is only active after `make hooks`.
#
# A commit message must contain one of:
#   - a ticket ID: <PROJECT>-<X>-<NNN> (upper-case prefix, hyphen-separated,
#     3+ digits, e.g. ABC-W-123)
#   - a ticket number: #<NNN> (3+ digits, e.g. #495)
#   - the literal [no-ticket] as an explicit opt-out
# Otherwise the commit is rejected (exit 1).
#
# Scope: with git config hooks.ticketRefAlways=true (set by `make hooks`) every
# commit is checked. Without it, only commits touching paths matching
# hooks.ticketRefScope are checked (default regex below).
#
# Merge, Revert, fixup! and squash! commits are not checked.
#
# Git calls the hook as: commit-msg <path-to-message-file>

set -euo pipefail

DEFAULT_SCOPE='^(repos|tools|\.claude)(/|$)'
TICKET_RE='[A-Z][A-Z0-9]*-[A-Z]-[0-9]{3,}|#[0-9]{3,}'

MSG_FILE="${1:-}"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

FIRST_LINE="$(head -n1 "$MSG_FILE" 2>/dev/null || true)"
case "$FIRST_LINE" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

ALWAYS="$(git config --bool hooks.ticketRefAlways 2>/dev/null || echo false)"
SCOPE="$(git config --get hooks.ticketRefScope 2>/dev/null || echo "$DEFAULT_SCOPE")"

if [ "$ALWAYS" != "true" ]; then
  if ! git diff --cached --name-only 2>/dev/null | grep -qE "$SCOPE"; then
    exit 0
  fi
fi

MSG="$(cat "$MSG_FILE")"

if printf '%s' "$MSG" | grep -qE "$TICKET_RE"; then
  exit 0
fi
if printf '%s' "$MSG" | grep -qF '[no-ticket]'; then
  exit 0
fi

cat >&2 <<EOF
commit-msg: the commit message has no ticket reference. Add a ticket ID
(<PROJECT>-<X>-<NNN>, e.g. ABC-W-123), a ticket number (#<NNN>, e.g. #495)
or the opt-out [no-ticket].

Example:  ABC-W-123: fix burn target
Or:       fix burn target [no-ticket]
EOF
exit 1
